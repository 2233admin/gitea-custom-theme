<!-- Liteyuki custom styles -->
<style>
#snowfall-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
    overflow: hidden;
}
.snowflake {
    position: absolute;
    top: -10px;
    color: white;
    user-select: none;
    pointer-events: none;
    animation-name: fall;
    animation-timing-function: linear;
    animation-iteration-count: 1;
}
@keyframes fall {
    to { transform: translateY(100vh); opacity: 0; }
}
</style>
