<script>
(function() {
    'use strict';
    var GITEA_URL = window.location.origin;
    var p = window.location.pathname;

    // ─── [1] 首页公告栏 ───
    function injectAnnounce() {
        if (p !== '/' && !p.startsWith('/explore')) return;
        var container = document.querySelector('.page-content .ui.container') ||
                        document.querySelector('.page-content');
        if (!container) return;
        if (sessionStorage.getItem('xart-dismiss-announce')) return;

        var div = document.createElement('div');
        div.id = 'xart-announce';
        div.innerHTML = '<span class="badge">NEW</span>' +
            '<span class="msg">CI Runner 已上线 — push 即触发 Actions | 评论 <code>/help</code> 查看 bot 命令 | <code>git push</code> 到不存在的 repo 自动创建</span>' +
            '<span class="dismiss" onclick="this.parentElement.remove();sessionStorage.setItem(\'xart-dismiss-announce\',1)">✕</span>';
        container.insertBefore(div, container.firstChild);
    }

    // ─── [2] Repo 统计卡片 (仅首页) ───
    function injectRepoStats() {
        if (p !== '/') return;
        var announce = document.getElementById('xart-announce');
        var container = announce ? announce.parentElement : document.querySelector('.page-content .ui.container');
        if (!container) return;

        fetch(GITEA_URL + '/api/v1/repos/search?limit=50&sort=updated', {
            headers: { 'Accept': 'application/json' }
        }).then(function(r){ return r.json(); }).then(function(d) {
            var repos = (d.data || d || []);
            var total = repos.length;
            var totalSize = 0, totalStars = 0, totalIssues = 0;
            repos.forEach(function(r) {
                totalSize += (r.size || 0);
                totalStars += (r.stars_count || 0);
                totalIssues += (r.open_issues_count || 0);
            });
            var sizeMB = (totalSize / 1024).toFixed(0);

            var div = document.createElement('div');
            div.id = 'xart-repo-stats';
            div.innerHTML =
                '<div class="xart-stat-card"><div class="num">' + total + '</div><div class="label">Repos</div></div>' +
                '<div class="xart-stat-card"><div class="num">' + sizeMB + 'M</div><div class="label">Total Size</div></div>' +
                '<div class="xart-stat-card"><div class="num">' + totalStars + '</div><div class="label">Stars</div></div>' +
                '<div class="xart-stat-card"><div class="num">' + totalIssues + '</div><div class="label">Open Issues</div></div>';

            var ref = announce || container.firstChild;
            if (ref && ref.nextSibling) {
                container.insertBefore(div, ref.nextSibling);
            } else {
                container.appendChild(div);
            }
        }).catch(function(){});
    }

    // ─── [3] 快捷操作浮球 (FAB) ───
    function injectFAB() {
        var fab = document.createElement('div');
        fab.id = 'xart-fab';
        fab.innerHTML =
            '<div class="fab-menu">' +
            '  <a href="/repo/create"><span class="icon">+</span>新建仓库</a>' +
            '  <a href="/explore/repos"><span class="icon">🔍</span>浏览仓库</a>' +
            '  <a href="/issues?type=your_repositories"><span class="icon">📋</span>我的 Issues</a>' +
            '  <a href="/-/admin" id="xart-admin-link"><span class="icon">⚙</span>管理面板</a>' +
            '  <a href="#" onclick="xartShowShortcuts();return false"><span class="icon">⌨</span>快捷键</a>' +
            '</div>' +
            '<button class="fab-btn" title="快捷操作">⚡</button>';
        document.body.appendChild(fab);

        var btn = fab.querySelector('.fab-btn');
        var menu = fab.querySelector('.fab-menu');
        btn.addEventListener('click', function(e) {
            e.stopPropagation();
            menu.classList.toggle('open');
        });
        document.addEventListener('click', function() { menu.classList.remove('open'); });
    }

    // ─── [4] Explore 页热门 Topics ───
    function injectHotTopics() {
        if (!p.startsWith('/explore')) return;
        var container = document.querySelector('.page-content .ui.container');
        if (!container) return;

        fetch(GITEA_URL + '/api/v1/topics/search?limit=20', {
            headers: { 'Accept': 'application/json' }
        }).then(function(r){ return r.json(); }).then(function(d) {
            var topics = d.topics || d || [];
            if (!topics.length) return;
            var div = document.createElement('div');
            div.id = 'xart-hot-topics';
            topics.slice(0, 15).forEach(function(t) {
                var name = t.name || t;
                var a = document.createElement('a');
                a.className = 'xart-topic-tag';
                a.href = '/explore/repos?q=&topic=1&tag=' + encodeURIComponent(name);
                a.textContent = '#' + name;
                div.appendChild(a);
            });
            var h = container.querySelector('h4, .explore-header, .ui.header');
            if (h) h.parentElement.insertBefore(div, h.nextSibling);
            else container.insertBefore(div, container.firstChild);
        }).catch(function(){});
    }

    // ─── [5] Repo 列表活跃度指示条 ───
    function injectActivityBars() {
        var cards = document.querySelectorAll('.repository-item, .flex-item');
        if (!cards.length) return;
        var now = Date.now();
        cards.forEach(function(card) {
            var timeEl = card.querySelector('relative-time, time');
            if (!timeEl) return;
            var dt = new Date(timeEl.getAttribute('datetime') || timeEl.textContent);
            var days = Math.max(0, (now - dt.getTime()) / 86400000);
            var pct = Math.max(5, Math.min(100, 100 - days * 2));
            var bar = document.createElement('div');
            bar.className = 'xart-activity-bar';
            bar.innerHTML = '<div class="fill" style="width:' + pct + '%"></div>';
            card.appendChild(bar);
        });
    }

    // ─── [6] 键盘快捷键 ───
    window.xartShowShortcuts = function() {
        var m = document.getElementById('xart-shortcuts-modal');
        if (m) { m.classList.toggle('open'); return; }
        m = document.createElement('div');
        m.id = 'xart-shortcuts-modal';
        m.className = 'open';
        m.innerHTML =
            '<div class="modal-content">' +
            '<h3>⌨ 快捷键</h3>' +
            '<div class="shortcut-row"><span>打开快捷键面板</span><kbd>?</kbd></div>' +
            '<div class="shortcut-row"><span>新建仓库</span><kbd>Shift+N</kbd></div>' +
            '<div class="shortcut-row"><span>搜索</span><kbd>/</kbd></div>' +
            '<div class="shortcut-row"><span>浏览仓库</span><kbd>G then E</kbd></div>' +
            '<div class="shortcut-row"><span>我的 Issues</span><kbd>G then I</kbd></div>' +
            '<div class="shortcut-row"><span>管理面板</span><kbd>G then A</kbd></div>' +
            '<div class="shortcut-row"><span>关闭弹窗</span><kbd>Esc</kbd></div>' +
            '</div>';
        m.addEventListener('click', function(e) {
            if (e.target === m) m.classList.remove('open');
        });
        document.body.appendChild(m);
    };

    var gPending = false;
    document.addEventListener('keydown', function(e) {
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) return;

        if (e.key === '?') { xartShowShortcuts(); return; }
        if (e.key === 'Escape') {
            var m = document.getElementById('xart-shortcuts-modal');
            if (m) m.classList.remove('open');
            var fab = document.querySelector('#xart-fab .fab-menu');
            if (fab) fab.classList.remove('open');
            return;
        }
        if (e.key === 'N' && e.shiftKey) { window.location.href = '/repo/create'; return; }

        if (e.key === 'g' || e.key === 'G') { gPending = true; setTimeout(function(){ gPending = false; }, 800); return; }
        if (gPending) {
            gPending = false;
            if (e.key === 'e') window.location.href = '/explore/repos';
            else if (e.key === 'i') window.location.href = '/issues?type=your_repositories';
            else if (e.key === 'a') window.location.href = '/-/admin';
        }
    });

    // ─── [7] Repo 页文件大小人性化 ───
    function enhanceFileSizes() {
        if (!p.match(/^\/[^/]+\/[^/]+\/?$/)) return;
        // Gitea 默认已经做了，跳过
    }

    // ─── [8] 看板快捷入口 ───
    function injectKanbanHint() {
        if (!p.match(/^\/[^/]+\/[^/]+\/issues\/?$/)) return;
        var header = document.querySelector('.list-header, .issue-list-header, .flex-list .flex-item:first-child');
        if (!header) return;
        var repoPath = p.replace(/\/issues\/?$/, '');
        var btn = document.createElement('a');
        btn.href = repoPath + '/projects';
        btn.className = 'xart-topic-tag';
        btn.style.marginLeft = '8px';
        btn.textContent = '📋 看板视图';
        var actionBar = document.querySelector('.issue-actions, .list-header-toggle');
        if (actionBar) actionBar.appendChild(btn);
    }

    // ─── Init ───
    document.addEventListener('DOMContentLoaded', function() {
        injectAnnounce();
        injectRepoStats();
        injectFAB();
        injectHotTopics();
        injectActivityBars();
        injectKanbanHint();
    });
})();
</script>

