<!-- XART effects — v4 -->
<script>
(function() {
    var bgImages = [
        '/assets/img/bg/73984979.jpg',
        '/assets/img/bg/73024750.jpg',
        '/assets/img/bg/75188095.jpg',
        '/assets/img/bg/74932889.jpg',
        '/assets/img/bg/69602151.jpg',
        '/assets/img/bg/65409886.jpg',
        '/assets/img/bg/64337772.jpg',
        '/assets/img/bg/0.jpg',
        '/assets/img/bg/1.jpg'
    ];

    // 检测登录页并加 class
    var p = window.location.pathname;
    var isLogin = (p === '/' || p === '/user/login' || p === '/user/sign_up' || p === '/user/forgot_password');
    if (isLogin) document.body.classList.add('xart-login-page');

    function initSlideshow() {
        var el = document.getElementById('xart-bg-slideshow');
        if (!el) return;
        var idx = Math.floor(Math.random() * bgImages.length);
        el.style.backgroundImage = "url('" + bgImages[idx] + "')";
        setInterval(function() {
            idx = (idx + 1) % bgImages.length;
            el.style.opacity = '0';
            setTimeout(function() {
                el.style.backgroundImage = "url('" + bgImages[idx] + "')";
                el.style.opacity = '1';
            }, 1500);
        }, 15000);
    }

    function initParticles() {
        var canvas = document.getElementById('xart-particles');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        var ps = [], max = 50, link = 120;
        function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
        resize(); window.addEventListener('resize', resize);
        for (var i = 0; i < max; i++) {
            ps.push({ x: Math.random()*canvas.width, y: Math.random()*canvas.height,
                       vx: (Math.random()-0.5)*0.4, vy: (Math.random()-0.5)*0.4,
                       r: Math.random()*1.5+0.5 });
        }
        (function draw() {
            ctx.clearRect(0,0,canvas.width,canvas.height);
            for (var i=0;i<ps.length;i++) {
                var p=ps[i]; p.x+=p.vx; p.y+=p.vy;
                if(p.x<0||p.x>canvas.width) p.vx*=-1;
                if(p.y<0||p.y>canvas.height) p.vy*=-1;
                ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
                ctx.fillStyle='rgba(0,180,255,0.4)'; ctx.fill();
                for(var j=i+1;j<ps.length;j++){
                    var q=ps[j], dx=p.x-q.x, dy=p.y-q.y, d=Math.sqrt(dx*dx+dy*dy);
                    if(d<link){ ctx.beginPath(); ctx.moveTo(p.x,p.y); ctx.lineTo(q.x,q.y);
                        ctx.strokeStyle='rgba(0,180,255,'+(1-d/link)*0.2+')';
                        ctx.lineWidth=0.5; ctx.stroke(); }
                }
            }
            requestAnimationFrame(draw);
        })();
    }

    function initRipple() {
        document.addEventListener('click', function(e) {
            var r = document.createElement('div');
            r.className = 'xart-ripple';
            r.style.left = e.clientX + 'px'; r.style.top = e.clientY + 'px';
            document.body.appendChild(r);
            setTimeout(function(){ r.remove(); }, 600);
        });
    }

    function initLoader() {
        var bar = document.getElementById('xart-loader');
        if (!bar) return;
        var p = 0, t = setInterval(function() {
            p += Math.random()*20+5; if(p>=90){clearInterval(t);p=90;} bar.style.width=p+'%';
        }, 100);
        window.addEventListener('load', function() {
            bar.style.width='100%';
            setTimeout(function(){bar.style.opacity='0';},300);
            setTimeout(function(){bar.remove();},600);
        });
    }

    function initTitle() {
        var orig = document.title;
        document.addEventListener('visibilitychange', function() {
            document.title = document.hidden ? '// SIGNAL LOST...' : orig;
        });
    }

    // === 初始化 ===
    initLoader();

    if (isLogin) {
        initSlideshow();
        initParticles();
        bgImages.forEach(function(s){ var img=new Image(); img.src=s; });
    }

    initRipple();
    initTitle();
})();
</script>
