<script>
/* Liquid Glass v6 — 棱镜边框 + 鼠标光泽 */
(function() {
    'use strict';
    var SEL = '.ui.segment, .ui.card, .ui.cards > .card';

    /* 棱镜折射边框 + 高光层 */
    function initPrism() {
        document.querySelectorAll(SEL).forEach(function(panel) {
            if (panel.querySelector('.lg-prism')) return;
            panel.style.position = 'relative';

            var prism = document.createElement('div');
            prism.className = 'lg-prism';
            prism.style.cssText = 'position:absolute;inset:-1px;border-radius:21px;padding:1px;' +
                'background:conic-gradient(from 0deg,' +
                'rgba(139,92,246,0),rgba(59,130,246,0.6),rgba(16,185,129,0.4),' +
                'rgba(251,191,36,0.5),rgba(239,68,68,0.4),rgba(167,139,250,0.6),rgba(139,92,246,0));' +
                '-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);' +
                '-webkit-mask-composite:xor;mask-composite:exclude;' +
                'opacity:0;pointer-events:none;z-index:3;transition:opacity 0.4s ease;';
            panel.appendChild(prism);

            var hl = document.createElement('div');
            hl.style.cssText = 'position:absolute;inset:0;border-radius:20px;' +
                'background:linear-gradient(145deg,rgba(255,255,255,0.06) 0%,transparent 40%);' +
                'pointer-events:none;z-index:1;';
            panel.appendChild(hl);

            panel.addEventListener('mouseenter', function() { prism.style.opacity = '1'; });
            panel.addEventListener('mouseleave', function() { prism.style.opacity = '0'; });
        });
    }

    /* 鼠标跟踪光泽 */
    function initSheen() {
        var panels = document.querySelectorAll(SEL);
        panels.forEach(function(panel) {
            if (panel.querySelector('.lg-sheen')) return;
            var sheen = document.createElement('div');
            sheen.className = 'lg-sheen';
            sheen.style.cssText = 'position:absolute;inset:0;border-radius:20px;pointer-events:none;z-index:2;' +
                'background:radial-gradient(600px 400px at 50% -30%,rgba(255,255,255,0.10),transparent 65%);' +
                'opacity:0;transition:opacity 0.3s ease;';
            panel.style.position = 'relative';
            panel.appendChild(sheen);
            panel.addEventListener('mouseenter', function() { sheen.style.opacity = '1'; });
            panel.addEventListener('mouseleave', function() { sheen.style.opacity = '0'; });
        });

        var raf = false;
        document.addEventListener('mousemove', function(e) {
            if (raf) return;
            raf = true;
            requestAnimationFrame(function() {
                panels.forEach(function(panel) {
                    var s = panel.querySelector('.lg-sheen');
                    if (!s) return;
                    var r = panel.getBoundingClientRect();
                    if (r.bottom < -100 || r.top > window.innerHeight + 100) return;
                    var x = ((e.clientX - r.left) / r.width * 100).toFixed(1);
                    var y = ((e.clientY - r.top) / r.height * 100).toFixed(1);
                    s.style.background = 'radial-gradient(600px 400px at ' + x + '% ' + y + '%,rgba(255,255,255,0.12),transparent 65%)';
                });
                raf = false;
            });
        });
    }

    /* Navbar 滚动增强 */
    function initNavScroll() {
        var nav = document.getElementById('navbar');
        if (!nav) return;
        var tick = false;
        window.addEventListener('scroll', function() {
            if (tick) return;
            tick = true;
            requestAnimationFrame(function() {
                var s = Math.min(window.scrollY / 200, 1);
                nav.style.backdropFilter = 'blur(' + (24 + s * 12) + 'px) saturate(180%) brightness(1.1)';
                nav.style.webkitBackdropFilter = nav.style.backdropFilter;
                tick = false;
            });
        });
    }

    function init() {
        initPrism();
        initSheen();
        initNavScroll();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>
